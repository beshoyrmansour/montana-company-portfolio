 # litellm-config.yaml - Main configuration for LiteLLM gateway

  # Model definitions for local LLM providers
  model_list:
    - model_name: "lmstudio-model"
      litellm_params:
        model: "lmstudio-model"
        api_base: "http://host.docker.internal:1234/v1"  # Host accessible from Docker
        api_key: "NULL"
        timeout: 300
        temperature: 0.7

    - model_name: "ollama-model"
      litellm_params:
        model: "ollama-model"
        api_base: "http://host.docker.internal:11434/v1"  # Host accessible from Docker
        api_key: "NULL"
        timeout: 300
        temperature: 0.7

    - model_name: "claude-local"
      litellm_params:
        model: "claude-local"
        api_base: "http://localhost:4000/v1/messages"  # Your local gateway endpoint
        api_key: "your-virtual-key-here"
        timeout: 300

  # Route configuration - how to handle different model requests
  routing:
    - model: "lmstudio-model"
      route_to: "lmstudio-model"
    - model: "ollama-model"
      route_to: "ollama-model"
    - model: "claude-local"
      route_to: "claude-local"

  # Virtual key management - needed for security
  virtual_keys:
    enabled: true

  # Logging configuration
  logging:
    level: "INFO"
    file: "./litellm.log"

  # Context monitoring and guardrail settings
  context_monitoring:
    enabled: true
    compact_at: 0.8  # 80% of context window before auto-compaction
    block_at: 0.95   # 95% of context window before blocking

  # Security and rate limiting
  rate_limiting:
    enabled: true
    max_requests_per_minute: 60

  # Health check configuration
  health_check:
    enabled: true
    endpoint: "/health/liveliness"